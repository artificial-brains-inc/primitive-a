#VRML_SIM R2025a utf8

WorldInfo {
  info [
    "Sensor-safe obstacle course: avoidable objects intersect the proximity-sensor plane; elevated furniture is genuinely passable underneath."
    "The example controller uses only proximity_left and proximity_right plus the two wheel motors."
    "Additional side and rear proximity sensors are installed for later experiments."
    "Camera is enabled and mounted at the front of the robot."
    "Avoidable obstacle collision geometry reaches at least 0.12 m from the floor except perimeter markers; underpasses provide at least 0.09 m clear height."
  ]
  title "E-puck Sensor-Safe Household / Factory Obstacle Course"
  basicTimeStep 16
  contactProperties [
    ContactProperties {
      material1 "course_floor"
      material2 "wheel"
      coulombFriction [
        1.2
      ]
      bounce 0
    }
    ContactProperties {
      material1 "course_floor"
      material2 "robot_body"
      coulombFriction [
        0.08
      ]
      bounce 0
    }
  ]
}
